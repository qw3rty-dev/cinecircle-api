# TMDB API
ACCESS_TOKEN = "Bearer {your_tmdb_access_token}"

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/cinecircle
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/cinecircle_test
REDIS_URL=yout_redis_url

# JWT Authentication
SECRET_KEY=your_super_secret_key
ALGORITHM="HS256" # or any other of your choice

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com